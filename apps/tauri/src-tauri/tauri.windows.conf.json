{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Escriba",
        "width": 1260,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/": "vendor/",
      "surreal/": "surreal/",
      "native/*.dll": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      }
    },
    "externalBin": [
      "binaries/EscribaNativeHost",
      "binaries/escriba-runtime",
      "binaries/escriba-sandbox"
    ]
  }
}
