{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Escriba",
        "width": 1260,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb"
    ],
    "externalBin": [
      "binaries/EscribaNativeHost",
      "binaries/escriba-runtime",
      "binaries/escriba-sandbox"
    ],
    "resources": {
      "vendor/": "vendor/",
      "surreal/": "surreal/",
      "native/": "native/"
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
