{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Escriba",
        "width": 1260,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "externalBin": [
      "binaries/EscribaNativeHost",
      "binaries/escriba-runtime",
      "binaries/escriba-sandbox"
    ],
    "resources": {
      "vendor/": "vendor/",
      "surreal/": "surreal/",
      "native/": "native/"
    },
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "alsa-lib",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugin-libav"
        ]
      }
    }
  }
}
